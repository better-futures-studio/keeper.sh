{
  "name": "keeper.sh",
  "devDependencies": {
    "knip": "5.80.0",
    "oxlint": "^1.55.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.0"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "arktype": "^2.2.0",
    "protobufjs": "7.6.6",
    "seroval": "1.7.6",
    "seroval-plugins": "1.7.6",
    "defu": "6.1.7",
    "nanoid": "3.3.20",
    "postcss": "8.5.32",
    "browserslist": "4.29.5",
    "source-map-js": "1.2.2",
    "vite": "8.1.6"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "clean": "rimraf --glob **/{.turbo,node_modules,.next/}/",
    "dev": "turbo run dev dev:root",
    "dev:root": "docker compose up --force-recreate",
    "types": "turbo run types --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "unused": "knip"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "applications/*",
      "services/*"
    ]
  }
}
